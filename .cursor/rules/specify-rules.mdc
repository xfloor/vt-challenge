### Video Composition

```typescript
// Remotion composition for 4-scene video
export const VideoComposition: React.FC<{ scenes: Scene[] }> = ({ scenes }) => {
  return (
    <Sequence durationInFrames={240}>
      {" "}
      {/* 8 seconds at 30fps */}
      {scenes.map((scene, index) => (
        <Sequence from={index * 60} durationInFrames={60}>
          {" "}
          {/* 2s each */}
          <SceneFrame scene={scene} />
        </Sequence>
      ))}
    </Sequence>
  );
};
```

