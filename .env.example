# AI Video Generation Web Application - Environment Variables
# Copy this file to .env.local and fill in your actual API keys

# OpenRouter API Key
# Required for text generation (titles, storyboards, prompts)
# Get your API key from: https://openrouter.ai/
OPENROUTER_API_KEY=your_openrouter_key_here

# Fal AI API Key  
# Required for image generation
# Get your API key from: https://fal.ai/
FAL_API_KEY=your_fal_api_key_here